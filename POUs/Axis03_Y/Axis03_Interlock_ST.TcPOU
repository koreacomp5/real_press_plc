<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Axis03_Interlock_ST" Id="{76b1b8d3-4239-4d1c-a88d-8ceb210f28bf}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Axis03_Interlock_ST
VAR
    Always_ON    : BOOL := TRUE;
    Always_OFF   : BOOL := FALSE;
    Axis02_Safe  : BOOL;
    InRange_Home : BOOL;
    InRange_Wait : BOOL;
    InRange_Work : BOOL;
END_VAR

VAR CONSTANT
    AXIS02_SAFE_LIMIT : REAL := 55.0;
    Y_MIN             : REAL := 3.4;
    Y_MAX             : REAL := 48.0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// ===== 공통 조건 =====
Axis02_Safe := GVL_Axis02.Real_Position <= AXIS02_SAFE_LIMIT;

InRange_Home := (GVL_Axis03.Home_Position_Data >= Y_MIN) AND (GVL_Axis03.Home_Position_Data <= Y_MAX);
InRange_Wait := (GVL_Axis03.Wait_Position_Data >= Y_MIN) AND (GVL_Axis03.Wait_Position_Data <= Y_MAX);
InRange_Work := (GVL_Axis03.Work_End_Position_Data >= Y_MIN) AND (GVL_Axis03.Work_End_Position_Data <= Y_MAX);

// ===== 개별 인터락 =====
GVL_Axis03.Home_Pos_Interlock     := Axis02_Safe OR InRange_Home;
GVL_Axis03.Wait_Pos_Interlock     := Axis02_Safe OR InRange_Wait;
GVL_Axis03.Work_End_Pos_Interlock := Axis02_Safe OR InRange_Work;
GVL_Axis03.Home_ORG_Interlock     := Axis02_Safe;

// ===== 최종 인터락 =====
GVL_Axis03.Interlock := GVL_Axis03.Home_Pos_Interlock AND 
                        GVL_Axis03.Wait_Pos_Interlock AND 
                        GVL_Axis03.Work_End_Pos_Interlock;]]></ST>
    </Implementation>
    <LineIds Name="Axis03_Interlock_ST">
      <LineId Id="15" Count="0" />
      <LineId Id="22" Count="15" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>