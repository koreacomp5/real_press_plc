  <POU Name="Axis02_X_1" Id="{5dee82d8-93f1-467b-b199-b926e0393542}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Axis02_X_1
VAR
	Axis02: AXIS_REF;											//회전축
	Axis02_MC_Home: FB_HomeBeforeMoveAX8000:=(channel:=2);
	Axis02_MC_Power: MC_Power;
	Axis02_Status: MC_ReadStatus;
	Axis02_Position_Read: MC_ReadActualPosition;
	Axis02_Velocity_Read: MC_ReadActualVelocity;
	Axis02_Reset: MC_Reset;										//모터 알람 리셋
	Axis02_Stop: MC_Stop;										//모터 정지
	Axis02_Press_Move: MC_MoveAbsolute;
	Axis02_Home_Pos_Move: MC_MoveAbsolute;
	Axis02_Wait_Pos_Move: MC_MoveAbsolute;
	Axis02_Target_Pos_Move: MC_MoveAbsolute;
	Axis02_Work_End_Move: MC_MoveAbsolute;
	Axis02_Jog: MC_Jog;
	
	Always_ON				:	BOOL	:=TRUE	;//상시 ON
	Always_OFF				:	BOOL	:=FALSE	;//상시 OFF
	Home_Interlock			:	Bool	;
	Home_Pos_Interlock		: 	BOOL	;
	Wait_Pos_Interlock		:	BOOL	;
	Target_Pos_Interlock	:	BOOL	;
	Work_End_POs_Interlock	:	BOOL	;
	
	Axis02_Calibration: MC_MoveAbsolute;
	Calibration_Pos_Interlock: BOOL;
	Axis02_Tool_Change: MC_MoveAbsolute;
	Axis02_Target_Move02: MC_MoveSuperImposed;
	Axis02_Target_Pos_Move02: MC_GearInVelo;
	Axis02_Move: MC_GearInVelo;
	test: BOOL;

	MC_GearIn_0: MC_GearIn;
	test01: BOOL;
	MC_MoveVelocity_0: MC_MoveVelocity;
	test02: BOOL;
END_VAR
]]></Declaration>
