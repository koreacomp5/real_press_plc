                                    <n n="Tag" />
                                    <v n="Text">"	GVL_Calibration.Calibration_Pos_Interlock := TRUE;"</v>
                                  </o>
                                  <o>
                                    <v n="Id">7132L</v>
                                    <n n="Tag" />
                                    <v n="Text">"ELSE"</v>
                                  </o>
                                  <o>
                                    <v n="Id">7133L</v>
                                    <n n="Tag" />
                                    <v n="Text">"    GVL_Calibration.Calibration_Pos_Interlock := FALSE;"</v>
                                  </o>
                                  <o>
                                    <v n="Id">7134L</v>
                                    <n n="Tag" />
                                    <v n="Text">"END_IF;"</v>
