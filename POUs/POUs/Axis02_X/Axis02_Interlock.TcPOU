                            <a n="TextLines" cet="TextLine">
                              <o>
                                <v n="Id">7124L</v>
                                <n n="Tag" />
                                <v n="Text">"IF (GVL_Calibration.Calibration_Pos_Interlock = TRUE) AND (GVL_Axis02.Home_Pos_Interlock = TRUE)"</v>
                              </o>
                              <o>
                                <v n="Id">7125L</v>
                                <n n="Tag" />
                                <v n="Text">"AND (GVL_Axis02.Wait_Pos_Interlock = TRUE) AND (GVL_Axis02.Target_Pos_Interlock = TRUE) AND (GVL_Axis02.Work_End_Pos_Interlock = TRUE) THEN"</v>
                              </o>
                              <o>
                                <v n="Id">7126L</v>
                                <n n="Tag" />
                                <v n="Text">"	GVL_Axis02.Interlock := TRUE;"</v>
                              </o>
                              <o>
                                <v n="Id">7127L</v>
                                <n n="Tag" />
                                <v n="Text">"	ELSE"</v>
                              </o>
                              <o>
                                <v n="Id">7128L</v>
                                <n n="Tag" />
                                <v n="Text">"	GVL_Axis02.Interlock := FALSE;	"</v>
                              </o>
