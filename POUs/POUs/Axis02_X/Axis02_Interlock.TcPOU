                                        <v n="Id">7136L</v>
                                        <n n="Tag" />
                                        <v n="Text">"IF (GVL_Axis02.Real_Position &gt; 55.0) THEN"</v>
                                      </o>
                                      <o>
                                        <v n="Id">7137L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	GVL_Axis02.Home_ORG_Interlock	:=	TRUE ;"</v>
                                      </o>
                                      <o>
                                        <v n="Id">7138L</v>
                                        <n n="Tag" />
                                        <v n="Text">"ELSE"</v>
                                      </o>
                                      <o>
                                        <v n="Id">7139L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	IF	GVL_Axis03.Home_Position OR "</v>
                                      </o>
                                      <o>
                                        <v n="Id">7140L</v>
                                        <n n="Tag" />
                                        <v n="Text">"		(GVL_Axis03.Real_Position &gt;= 12.6) AND"</v>
                                      </o>
                                      <o>
                                        <v n="Id">7141L</v>
                                        <n n="Tag" />
                                        <v n="Text">"		(GVL_Axis03.Real_Position &lt;= 18.6) THEN"</v>
                                      </o>
                                      <o>
                                        <v n="Id">7142L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	GVL_Axis02.Home_ORG_Interlock	:=	 TRUE	;"</v>
                                      </o>
                                      <o>
                                        <v n="Id">7143L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	END_IF"</v>
                                      </o>
                                      <o>
                                        <v n="Id">7115L</v>
                                        <n n="Tag" />
                                        <v n="Text">"END_IF"</v>
                                      </o>
