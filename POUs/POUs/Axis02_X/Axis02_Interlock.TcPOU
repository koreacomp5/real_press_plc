                                    <n n="Tag" />
                                    <v n="Text">"IF (GVL_Axis01.Real_Position &gt; 32.9) AND (GVL_Axis03.Real_Position &gt;= -4) AND (GVL_Axis03.Real_Position &lt;= 34)THEN"</v>
                                  </o>
                                  <o>
