  <POU Name="Axis05_Rotation_1" Id="{3b9241cc-323a-4d20-8fae-4dc2afed286d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Axis05_Rotation_1
VAR
	Axis05: AXIS_REF;											//회전축
	Axis05_MC_Home: FB_HomeBeforeMoveAX8000;
	Axis05_MC_Power: MC_Power;
	Axis05_Status: MC_ReadStatus;
	Axis05_Position_Read: MC_ReadActualPosition;
	Axis05_Velocity_Read: MC_ReadActualVelocity;
	Axis05_Reset: MC_Reset;										//모터 알람 리셋
	Axis05_Stop: MC_Stop;										//모터 정지
	Axis05_Press_Move: MC_MoveAbsolute;
	Axis05_Home_Pos_Move: MC_MoveAbsolute;
	Axis05_Wait_Pos_Move: MC_MoveAbsolute;
	Axis05_Target_Pos_Move: MC_MoveAbsolute;
	Axis05_Work_End_Move: MC_MoveAbsolute;
	Axis05_Jog: MC_Jog;
	
	Always_ON	:	BOOL	:=TRUE	;//상시 ON
	Always_OFF	:	BOOL	:=FALSE	;//상시 OFF

	Home_Interlock			:	BOOL	;
	Home_Pos_Interlock		: 	BOOL	;
	Wait_Pos_Interlock		:	BOOL	;
	Target_Pos_Interlock	:	BOOL	;
	Work_End_POs_Interlock	:	BOOL	;
	Axis05_Calibration: MC_MoveAbsolute;
END_VAR
]]></Declaration>
