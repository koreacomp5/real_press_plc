                      <v n="CallType" t="Operator">None</v>
                      <v n="EN">true</v>
                      <v n="ENO">true</v>
                      <o n="STSnippet" t="STSnippet">
                        <o n="STSnippet" t="STImplementationObject">
                          <o n="TextDocument" t="TextDocument">
                            <a n="TextLines" cet="TextLine">
                              <o>
                                <v n="Id">6156L</v>
                                <n n="Tag" />
                                <v n="Text">"IF (GVL_Calibration.Calibration_Pos_Interlock = TRUE) AND (Home_Pos_Interlock = TRUE)"</v>
                              </o>
                              <o>
                                <v n="Id">6157L</v>
                                <n n="Tag" />
                                <v n="Text">"AND (Wait_Pos_Interlock = TRUE) AND (Target_Pos_Interlock = TRUE) AND (Work_End_POs_Interlock = TRUE) THEN"</v>
                              </o>
                              <o>
                                <v n="Id">6158L</v>
                                <n n="Tag" />
                                <v n="Text">"	GVL_Axis05.Interlock := TRUE;"</v>
                              </o>
                              <o>
                                <v n="Id">6159L</v>
                                <n n="Tag" />
                                <v n="Text">"	ELSE"</v>
                              </o>
                              <o>
                                <v n="Id">6160L</v>
                                <n n="Tag" />
                                <v n="Text">"	GVL_Axis05.Interlock := FALSE;	"</v>
                              </o>
                              <o>
                                <v n="Id">6161L</v>
                                <n n="Tag" />
                                <v n="Text">""</v>
                              </o>
                              <o>
                                <v n="Id">6148L</v>
                                <n n="Tag" />
                                <v n="Text">"END_IF"</v>
                              </o>
                            </a>
                          </o>
                        </o>
                        <v n="Id">6162L</v>
                      </o>
                      <v n="ContainsExtensibleInputs">false</v>
                      <v n="ProvidesSTSnippet">true</v>
