                              <o n="TextDocument" t="TextDocument">
                                <a n="TextLines" cet="TextLine">
                                  <o>
                                    <v n="Id">3402L</v>
                                    <n n="Tag" />
                                    <v n="Text">"IF (GVL_Axis02.Real_Position &lt;= 55.0) THEN"</v>
                                  </o>
                                  <o>
                                    <v n="Id">3403L</v>
                                    <n n="Tag" />
                                    <v n="Text">"    Home_Pos_Interlock := TRUE;"</v>
                                  </o>
                                  <o>
                                    <v n="Id">3404L</v>
                                    <n n="Tag" />
                                    <v n="Text">"ELSE"</v>
                                  </o>
                                  <o>
                                    <v n="Id">3405L</v>
                                    <n n="Tag" />
                                    <v n="Text">"    IF (GVL_Axis03.Home_Position_Data &gt;= 12.1) AND "</v>
