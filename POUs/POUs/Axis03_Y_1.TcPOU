  <POU Name="Axis03_Y_1" Id="{7a485589-d280-412f-9a99-ba86b486434b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Axis03_Y_1
VAR
	Axis03: AXIS_REF;											//회전축
	Axis03_MC_Home: FB_HomeBeforeMoveAX8000;
	Axis03_MC_Power: MC_Power;
	Axis03_Status: MC_ReadStatus;
	Axis03_Position_Read: MC_ReadActualPosition;
	Axis03_Velocity_Read: MC_ReadActualVelocity;
	Axis03_Reset: MC_Reset;										//모터 알람 리셋
	Axis03_Stop: MC_Stop;										//모터 정지
	Axis03_Press_Move: MC_MoveAbsolute;
	Axis03_Home_Pos_Move: MC_MoveAbsolute;
	Axis03_Wait_Pos_Move: MC_MoveAbsolute;
	Axis03_Target_Pos_Move: MC_MoveAbsolute;
	Axis03_Work_End_Move: MC_MoveAbsolute;
	Axis03_Jog: MC_Jog;	
	
	
	Always_ON	:	BOOL	:=TRUE	;//상시 ON
	Always_OFF	:	BOOL	:=FALSE	;//상시 OFF
	Home_Interlock			:	BOOL	;
	Home_Pos_Interlock		: 	BOOL	;
	Wait_Pos_Interlock		:	BOOL	;
	Target_Pos_Interlock	:	BOOL	;
	Work_End_POs_Interlock	:	BOOL	;

	Axis03_Calibration: MC_MoveAbsolute;
	Axis03_Tool_Change: MC_MoveAbsolute;
END_VAR
]]></Declaration>
