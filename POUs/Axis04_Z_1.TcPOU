<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Axis04_Z_1" Id="{2a0472e6-ef59-475e-88bb-8c5956697ac2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Axis04_Z_1
VAR
	Axis04: AXIS_REF;											//회전축
	Axis04_MC_Home: FB_HomeBeforeMoveAX8000:=(channel:=2);
	Axis04_MC_Power: MC_Power;
	Axis04_Status: MC_ReadStatus;
	Axis04_Position_Read: MC_ReadActualPosition;
	Axis04_Velocity_Read: MC_ReadActualVelocity;
	Axis04_Reset: MC_Reset;										//모터 알람 리셋
	Axis04_Stop: MC_Stop;										//모터 정지
	Axis04_Press_Move: MC_MoveAbsolute;
	Axis04_Home_Pos_Move: MC_MoveAbsolute;
	Axis04_Wait_Pos_Move: MC_MoveAbsolute;
	Axis04_Target_Pos_Move: MC_MoveAbsolute;
	Axis04_Work_End_Move: MC_MoveAbsolute;
	Axis04_Jog: MC_Jog;
	
	
	Always_ON	:	BOOL	:=TRUE	;//상시 ON
	Always_OFF	:	BOOL	:=FALSE	;//상시 OFF


	ddd: FB_HomeBeforeMoveAX8000;
	Axis04_Tool_Change: MC_MoveAbsolute;
	TON_555: TON;
	TON_500: TON;
END_VAR
]]></Declaration>
