<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Axis02_Task_Offset" Id="{6609e7a2-7960-4e19-8f7e-1823f89707ca}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Axis02_Task_Offset
VAR
    (* 입력 및 제어 관련 변수 *)
    trigVisionOk    : R_TRIG;   // Vision_OK 신호의 상승 에지 감지용 함수 블록
    bIsSavingActive : BOOL := FALSE; // 데이터 저장 활성화 플래그
    
    (* 데이터 저장 버퍼 및 인덱스 관련 변수 *)
    nDataCount      : DINT := 0;    // 현재까지 저장된 데이터 개수 (인덱스 역할)
    b               : ARRAY[0..8000] OF LREAL; // 엔코더 위치 데이터 저장 배열
    
    (* 실시간 탐색 및 결과 저장 변수 *)
    nFirstDiffIndex : DINT := 0; // [결과] 변화가 시작된 첫 번째 인덱스 (0이면 '아직 못 찾음')
    rErrorValue     : LREAL := 0.0; // [결과] 변화가 발생한 지점의 오차값 (변화량)
    
    // 실수 비교를 위한 허용 오차 (EPSILON). 시스템 환경에 맞게 조정 필요.
    rEpsilon        : LREAL := 1.0E-5; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*===================================================================
   PLC 코드 실행 로직
===================================================================*)

// 1. Vision_OK 신호의 상승 에지 감지 및 초기화 (이전 코드와 동일)
trigVisionOk(CLK := GVL_Vision.Vision_OK);

IF trigVisionOk.Q THEN
    bIsSavingActive := TRUE; 
    nDataCount := 0;
    nFirstDiffIndex := 0; 
    rErrorValue := 0.0;
END_IF

// 2. 데이터 저장 및 실시간 변화 감지 로직
IF bIsSavingActive THEN
    
    // 2-1. 카운터가 8000 미만일 때만 실행 (저장)
    IF nDataCount < 8000 THEN
        
        nDataCount := nDataCount + 1;
        b[nDataCount] := GVL_Vision.Target_X_Real_Position_Data;
        
        // 2-2. 실시간 변화 감지 로직 (b[3]부터의 변화 감시)
        IF (nFirstDiffIndex = 0) AND (nDataCount >= 3) THEN
            
            // 변화 감지 (이전과 동일)
            IF ABS(b[nDataCount] - b[nDataCount - 1]) > rEpsilon THEN
                
                // 변화가 감지된 첫 번째 인덱스 저장
                nFirstDiffIndex := nDataCount;
                
                // --- 오차값 계산 로직 수정 ---
                // (인덱스 낮은 값) - (인덱스 높은 값)
                // (변화 직전의 과거 값) - (변화가 발생한 현재 값)
                GVL_System.Offset_Value := b[nFirstDiffIndex - 1] - b[nFirstDiffIndex]; 
                
            END_IF
            
        END_IF
        
        // 2-3. 인덱스가 8000에 도달하면 저장 플래그를 비활성화 (저장 종료)
        IF nDataCount = 8000 THEN
            bIsSavingActive := FALSE;  
        END_IF
    
    END_IF
    
END_IF]]></ST>
    </Implementation>
    <LineIds Name="Axis02_Task_Offset">
      <LineId Id="308" Count="47" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>