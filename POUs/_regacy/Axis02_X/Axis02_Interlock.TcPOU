                                <n n="Tag" />
                                <v n="Text">"IF (GVL_Axis02.Home_Pos_Interlock = TRUE) AND (GVL_Axis02.Wait_Pos_Interlock = TRUE) AND (GVL_Axis02.Target_Pos_Interlock = TRUE) AND (GVL_Axis02.Work_End_Pos_Interlock = TRUE) THEN"</v>
                              </o>
                              <o>
                                <v n="Id">10351L</v>
                                <n n="Tag" />
                                <v n="Text">"	GVL_Axis02.Interlock := TRUE;"</v>
