                                    <n n="Tag" />
                                    <v n="Text">"IF (GVL_Axis01.Real_Position &gt; 32.9) AND (GVL_Axis03.Real_Position &gt;= -6) AND (GVL_Axis03.Real_Position &lt;= 40)THEN"</v>
                                  </o>
