                                        <v n="Id">10361L</v>
                                        <n n="Tag" />
                                        <v n="Text">"IF (GVL_Axis02.Real_Position &gt; 55.0) THEN"</v>
                                      </o>
                                      <o>
                                        <v n="Id">10362L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	GVL_Axis02.Home_ORG_Interlock	:=	TRUE ;"</v>
                                      </o>
                                      <o>
                                        <v n="Id">10363L</v>
                                        <n n="Tag" />
                                        <v n="Text">"ELSE"</v>
                                      </o>
                                      <o>
                                        <v n="Id">10364L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	IF	GVL_Axis03.Home_Position OR "</v>
                                      </o>
                                      <o>
                                        <v n="Id">10365L</v>
                                        <n n="Tag" />
                                        <v n="Text">"		(GVL_Axis03.Real_Position &gt;= 3.4) AND"</v>
                                      </o>
                                      <o>
                                        <v n="Id">10366L</v>
                                        <n n="Tag" />
                                        <v n="Text">"		(GVL_Axis03.Real_Position &lt;= 30.0) THEN"</v>
                                      </o>
                                      <o>
                                        <v n="Id">10367L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	GVL_Axis02.Home_ORG_Interlock	:=	 TRUE	;"</v>
                                      </o>
                                      <o>
                                        <v n="Id">10368L</v>
                                        <n n="Tag" />
                                        <v n="Text">"	END_IF"</v>
                                      </o>
                                      <o>
                                        <v n="Id">10341L</v>
                                        <n n="Tag" />
                                        <v n="Text">"END_IF"</v>
                                      </o>
