<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="Moving_Speed" Id="{fbdfb93e-8125-428e-8b40-195a7d6daecf}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Moving_Speed
VAR
	iArraySize                : UINT := 60000;
// --- 1. 로깅 제어 및 상태 변수 ---
    trigVisionOk              : R_TRIG;   // Vision_OK 신호의 상승 에지 감지용
    bIsSavingActive           : BOOL := FALSE; // 데이터 수집 활성화 플래그
    bDataReadyForProcessing   : BOOL := FALSE; // 데이터 수집 완료 및 평균 계산 준비 플래그
    
    // --- 2. 로깅 인덱스 및 계산용 변수 ---
    nDataCount                : UDINT := 0;   // 현재 배열 인덱스 및 카운터 (0 ~ 59999)
    nIndex                    : UDINT := 0;   // FOR 루프 인덱스 변수
    
    // --- 3. 평균 계산 변수 ---
    fSumOfData                : LREAL := 0.0; // 0이 아닌 데이터의 누적 합계
    nValidCount               : UDINT := 0;   // 0이 아닌 유효 데이터의 개수
    fFinalAverage             : LREAL := 0.0; // 최종 계산된 유효 평균 값 (결과 출력용)
	Encoder_Speed_Data        : ARRAY [0..59999] OF LREAL; // 실제 데이터 저장 배열
	Test01: BOOL;
	fSumOfData_Accumulated: LREAL;
	nValidCount_Accumulated: UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =====================================================================
// 0. 강제 리셋 로직
// =====================================================================
(*IF GVL_Motion_Step.Axis02_Stop OR GVL_System.All_Initial THEN
    
    // 모든 제어 플래그와 실시간 누적 변수 리셋
    bIsSavingActive           := FALSE;
    bDataReadyForProcessing   := FALSE;
    
    nDataCount                := 0;
    fSumOfData_Accumulated    := 0.0; 
    nValidCount_Accumulated   := 0;   
	GVL_Vision.Average_Speed  := 0;
	fFinalAverage			  := 0;

END_IF

// =====================================================================
// 1. 데이터 로깅 시작 트리거 및 초기화
// =====================================================================
trigVisionOk(CLK := GVL_Vision.Cam_Trigger);

IF trigVisionOk.Q THEN
    // 0단계 리셋 로직이 실행되지 않았을 때만 초기화/시작
    IF NOT bIsSavingActive THEN 
        bIsSavingActive           := TRUE;             
        nDataCount                := 0;                     
        bDataReadyForProcessing   := FALSE;    
        
        // 실시간 누적 변수 초기화
        fSumOfData_Accumulated    := 0.0;       
        nValidCount_Accumulated   := 0;       
        fFinalAverage             := 0.0;     
    END_IF
END_IF

// =====================================================================
// 2. 데이터 저장 및 실시간 유효 평균 계산 로직
// =====================================================================
IF bIsSavingActive THEN
    
    // 2-1. 카운터가 60000 미만일 때만 실행
    IF nDataCount < iArraySize THEN
        
        // 1. 현재 GVL 데이터를 배열에 저장
        Encoder_Speed_Data[nDataCount] := GVL_Encoder.Real_Velocity;
        
        // 2. <실시간 평균 계산>
        IF Encoder_Speed_Data[nDataCount] <> 0.0 THEN
            
            // 누적 합계 갱신
            fSumOfData_Accumulated := fSumOfData_Accumulated + Encoder_Speed_Data[nDataCount]; 
            
            // 유효 데이터 카운트 갱신
            nValidCount_Accumulated := nValidCount_Accumulated + 1;
            
        END_IF
        
        // 3. 실시간 평균 계산 (유효 카운트가 0보다 클 경우에만)
        IF nValidCount_Accumulated > 0 THEN
            fFinalAverage := fSumOfData_Accumulated / UDINT_TO_LREAL(nValidCount_Accumulated);
        ELSE
            fFinalAverage := 0.0;
        END_IF
        
        // 4. Task 1회 실행마다 카운터 1 증가
        nDataCount := nDataCount + 1;
        
        // 2-2. 인덱스가 60000에 도달하면 로깅 중단
        IF nDataCount = iArraySize THEN
            bIsSavingActive := FALSE;             
            bDataReadyForProcessing := TRUE; // 로깅 완료 신호
        END_IF
    
    END_IF
    
END_IF
GVL_Vision.Average_Speed := fFinalAverage ;*)]]></ST>
    </Implementation>
    <LineIds Name="Moving_Speed">
      <LineId Id="287" Count="11" />
      <LineId Id="384" Count="1" />
      <LineId Id="299" Count="61" />
      <LineId Id="5" Count="0" />
      <LineId Id="363" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>